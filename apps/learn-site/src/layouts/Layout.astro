---
interface Props {
  title: string;
  description?: string;
  section?: string;
}

const {
  title,
  description = 'AuthMatrix IAM Masterclass — OAuth 2.0, OpenID Connect, JWT and modern identity protocols, explained clearly with hands-on labs.',
  section = ''
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Nav items: [label, path]
const nav = [
  ['Home',         '/'],
  ['OAuth 2.0',    '/oauth'],
  ['Grant Types',  '/flows'],
  ['OIDC',         '/oidc'],
  ['Tokens & JWT', '/tokens'],
  ['API Guide',    '/api-guide'],
  ['Labs',         '/labs'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090d16" />
    <meta property="og:title" content={title + ' | AuthMatrix'} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={base + '/favicon.svg'} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title} | AuthMatrix IAM Masterclass</title>
  </head>
  <body>

    <header class="navbar">
      <div class="nav-inner">
        <a href={base + '/'} class="brand">
          <span>&#9889;</span>
          <span class="brand-name">AuthMatrix</span>
          <span class="brand-pill">IAM Masterclass</span>
        </a>

        <nav class="nav-links" id="nav-links">
          {nav.map(([label, path]) => (
            <a
              href={base + path}
              class={section === label ? 'nav-active' : ''}
            >
              {label}
            </a>
          ))}
        </nav>

        <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p>
          <strong>&#9889; AuthMatrix IAM Masterclass</strong> &mdash;
          Open-source identity learning.
          <a href="https://github.com/sepand/AuthMatrix" target="_blank" rel="noopener">GitHub</a>
        </p>
        <p class="footer-refs">
          Sourced from:
          <a href="https://datatracker.ietf.org/doc/html/rfc6749" target="_blank" rel="noopener">RFC 6749</a>
          &middot;
          <a href="https://datatracker.ietf.org/doc/html/rfc7519" target="_blank" rel="noopener">RFC 7519</a>
          &middot;
          <a href="https://openid.net/specs/openid-connect-core-1_0.html" target="_blank" rel="noopener">OIDC Core 1.0</a>
          &middot;
          <a href="https://datatracker.ietf.org/doc/html/rfc9700" target="_blank" rel="noopener">RFC 9700</a>
        </p>
      </div>
    </footer>

  </body>
</html>

<style is:global>
  /* ── Design Tokens ──────────────────────────────────────────────────── */
  :root {
    --bg:             #090d16;
    --surface:        #111827;
    --surface-2:      #162032;
    --border:         #1f293d;
    --text:           #f1f5f9;
    --muted:          #94a3b8;
    --primary:        #38bdf8;
    --primary-dim:    rgba(56,189,248,0.12);
    --success:        #34d399;
    --success-dim:    rgba(52,211,153,0.12);
    --warning:        #fbbf24;
    --warning-dim:    rgba(251,191,36,0.12);
    --danger:         #f87171;
    --danger-dim:     rgba(248,113,113,0.12);
    --purple:         #a78bfa;
    --purple-dim:     rgba(167,139,250,0.12);
    --radius:         8px;
    --font:           'Plus Jakarta Sans', system-ui, sans-serif;
    --mono:           'JetBrains Mono', 'Fira Code', monospace;
    --nav-h:          60px;
  }

  /* ── Reset ──────────────────────────────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    line-height: 1.7;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
  }
  img, svg { display: block; max-width: 100%; }
  a { color: var(--primary); }

  /* ── Navbar ─────────────────────────────────────────────────────────── */
  .navbar {
    background: rgba(9,13,22,0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-h);
  }

  .nav-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text);
    font-weight: 800;
    font-size: 1.05rem;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .brand-pill {
    background: var(--primary-dim);
    color: var(--primary);
    border: 1px solid rgba(56,189,248,0.2);
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    letter-spacing: 0.04em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    flex: 1;
  }

  .nav-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
    white-space: nowrap;
  }

  .nav-links a:hover,
  .nav-links a.nav-active {
    color: var(--text);
    background: rgba(255,255,255,0.06);
  }

  .nav-links a.nav-active { color: var(--primary); }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.4rem;
    margin-left: auto;
  }

  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: all 0.2s;
  }

  /* ── Main ───────────────────────────────────────────────────────────── */
  #main {
    flex: 1;
    width: 100%;
  }

  /* ── Shared page wrapper ─────────────────────────────────────────────── */
  .page-wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
  }

  /* ── Learn layout: sidebar + content ────────────────────────────────── */
  .learn-layout {
    display: flex;
    gap: 3rem;
    align-items: flex-start;
  }

  /* Sidebar */
  .toc {
    width: 220px;
    flex-shrink: 0;
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
    max-height: calc(100vh - var(--nav-h) - 3rem);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .toc-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    font-weight: 700;
    margin-bottom: 0.75rem;
    display: block;
    padding: 0 0.25rem;
  }

  .toc ul { list-style: none; }
  .toc li { margin-bottom: 0.125rem; }

  .toc a {
    display: block;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.8rem;
    line-height: 1.4;
    padding: 0.3rem 0.5rem;
    border-radius: 5px;
    border-left: 2px solid transparent;
    transition: all 0.15s;
  }

  .toc a:hover { color: var(--text); background: rgba(255,255,255,0.04); }
  .toc a.toc-active { color: var(--primary); border-left-color: var(--primary); background: var(--primary-dim); }

  .toc-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 1rem 0;
  }

  .toc-nav { display: flex; flex-direction: column; gap: 0.25rem; }
  .toc-nav a { color: var(--primary); font-size: 0.8rem; padding: 0.25rem 0.5rem; text-decoration: none; border-radius: 4px; }
  .toc-nav a:hover { background: var(--primary-dim); }

  /* Content */
  .content {
    flex: 1;
    min-width: 0;
  }

  /* ── Typography ─────────────────────────────────────────────────────── */
  .content h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--primary);
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }

  .content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }

  .content h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    margin-top: 2rem;
    margin-bottom: 0.6rem;
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }

  .content h4 { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.5rem; }

  .content p { margin-bottom: 1.25rem; font-size: 0.975rem; }

  .lead { font-size: 1.05rem; color: var(--muted); max-width: 640px; line-height: 1.75; margin-bottom: 2rem; }

  .content ul, .content ol { padding-left: 1.5rem; margin-bottom: 1.25rem; }
  .content li { margin-bottom: 0.4rem; font-size: 0.975rem; }

  /* ── Code ───────────────────────────────────────────────────────────── */
  .content pre {
    background: #060b12;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    font-family: var(--mono);
    font-size: 0.83rem;
    line-height: 1.7;
    position: relative;
  }

  .content pre code { background: none; padding: 0; color: #cbd5e1; font-size: inherit; }
  .content code {
    font-family: var(--mono);
    font-size: 0.875em;
    color: var(--primary);
    background: var(--primary-dim);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }
  .content a code { color: inherit; }

  /* Code comments */
  .c { color: var(--muted); font-style: italic; }

  /* ── Tables ─────────────────────────────────────────────────────────── */
  .content table { width: 100%; border-collapse: collapse; margin-bottom: 1.5rem; font-size: 0.875rem; }
  .content th, .content td { padding: 0.6rem 0.875rem; border: 1px solid var(--border); text-align: left; vertical-align: top; }
  .content th { background: var(--surface); font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
  .content tr:nth-child(even) td { background: rgba(255,255,255,0.015); }

  /* ── Callouts ───────────────────────────────────────────────────────── */
  .callout {
    padding: 0.875rem 1.25rem;
    border-radius: var(--radius);
    margin-bottom: 1.5rem;
    border-left: 3px solid;
  }
  .callout p { margin-bottom: 0.4rem; font-size: 0.9rem; }
  .callout p:last-child { margin-bottom: 0; }
  .callout ul { margin-bottom: 0; }
  .callout strong { display: block; margin-bottom: 0.35rem; }
  .callout.note    { border-color: var(--primary); background: var(--primary-dim); }
  .callout.tip     { border-color: var(--success); background: var(--success-dim); }
  .callout.warning { border-color: var(--warning); background: var(--warning-dim); }
  .callout.danger  { border-color: var(--danger);  background: var(--danger-dim);  }

  /* ── Badges ─────────────────────────────────────────────────────────── */
  .badge {
    display: inline-block;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .badge-beginner    { background: var(--success-dim); color: var(--success); }
  .badge-intermediate{ background: var(--warning-dim); color: var(--warning); }
  .badge-advanced    { background: var(--danger-dim);  color: var(--danger); }
  .badge-lab         { background: var(--purple-dim);  color: var(--purple); }

  /* ── Page header ────────────────────────────────────────────────────── */
  .page-header { margin-bottom: 2.5rem; }
  .page-header .badge { margin-bottom: 0.75rem; }

  /* ── Page footer nav ────────────────────────────────────────────────── */
  .page-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .page-footer h3 { font-size: 0.85rem; color: var(--muted); margin-bottom: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .page-footer ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-bottom: 2rem; }
  .page-footer li { font-size: 0.85rem; }
  .page-footer a { text-decoration: none; }
  .page-footer a:hover { text-decoration: underline; }

  .prev-next {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .prev-next a {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.875rem;
    padding: 0.6rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s, background 0.15s;
    flex: 1;
    max-width: 280px;
  }
  .prev-next a:hover { border-color: var(--primary); background: var(--primary-dim); }
  .prev-next a.next { text-align: right; margin-left: auto; }
  .prev-next-label { font-size: 0.72rem; color: var(--muted); display: block; margin-bottom: 0.15rem; text-transform: uppercase; letter-spacing: 0.05em; }

  /* ── Site footer ────────────────────────────────────────────────────── */
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 1.25rem 1.5rem;
    text-align: center;
  }
  .footer-inner { max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 0.35rem; }
  .footer-inner p { font-size: 0.82rem; color: var(--muted); }
  .footer-inner a { color: var(--primary); text-decoration: none; }
  .footer-inner a:hover { text-decoration: underline; }
  .footer-refs { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }

  /* ── Responsive ─────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .learn-layout { flex-direction: column; }
    .toc {
      width: 100%;
      position: static;
      max-height: none;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: 1.5rem;
    }
    .toc ul { display: flex; flex-wrap: wrap; gap: 0.25rem; }
    .toc li { margin-bottom: 0; }
    .toc a { border-left: none; border-bottom: 2px solid transparent; }
    .toc a.toc-active { border-left-color: transparent; border-bottom-color: var(--primary); }
    .toc-divider { display: none; }
    .toc-nav { flex-direction: row; }
  }

  @media (max-width: 640px) {
    .nav-links { display: none; }
    .nav-links.open {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: var(--nav-h);
      left: 0; right: 0;
      background: rgba(9,13,22,0.98);
      border-bottom: 1px solid var(--border);
      padding: 1rem 1.5rem;
      gap: 0.25rem;
      z-index: 99;
    }
    .hamburger { display: flex; }
    .page-wrap { padding: 1.5rem 1rem 4rem; }
    .prev-next a { font-size: 0.8rem; padding: 0.5rem 0.75rem; }
  }
</style>

<script>
  // Mobile hamburger
  const hb = document.getElementById('hamburger');
  const nl = document.getElementById('nav-links');
  hb?.addEventListener('click', () => {
    const open = nl?.classList.toggle('open');
    hb.setAttribute('aria-expanded', String(open));
  });

  // Close mobile nav on link click
  nl?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    nl.classList.remove('open');
    hb?.setAttribute('aria-expanded', 'false');
  }));

  // TOC scroll spy
  const headings = document.querySelectorAll('.content h2[id], .content h3[id]');
  const tocLinks = document.querySelectorAll('.toc a[href^="#"]');
  if (headings.length && tocLinks.length) {
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          tocLinks.forEach(l => l.classList.remove('toc-active'));
          document.querySelector(`.toc a[href="#${e.target.id}"]`)?.classList.add('toc-active');
        }
      });
    }, { rootMargin: '-15% 0% -65% 0%' });
    headings.forEach(h => io.observe(h));
  }

  // Copy-to-clipboard on all pre blocks
  document.querySelectorAll('.content pre').forEach(pre => {
    const btn = Object.assign(document.createElement('button'), {
      textContent: 'Copy',
      className: 'copy-btn'
    });
    Object.assign(btn.style, {
      position: 'absolute', top: '0.5rem', right: '0.5rem',
      background: 'rgba(56,189,248,0.1)', color: '#38bdf8',
      border: '1px solid rgba(56,189,248,0.2)', padding: '0.15rem 0.5rem',
      borderRadius: '4px', fontSize: '0.7rem', cursor: 'pointer',
      fontFamily: 'inherit', transition: 'background 0.15s'
    });
    pre.style.position = 'relative';
    pre.appendChild(btn);
    btn.addEventListener('click', async () => {
      const text = pre.innerText.replace(/^Copy\n/, '');
      await navigator.clipboard.writeText(text).catch(() => {});
      btn.textContent = 'Copied!';
      btn.style.color = '#34d399';
      setTimeout(() => { btn.textContent = 'Copy'; btn.style.color = '#38bdf8'; }, 1500);
    });
  });
</script>

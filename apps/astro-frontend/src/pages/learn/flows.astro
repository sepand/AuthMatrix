  /* Flow steps */
  .flow-steps { display: flex; flex-direction: column; gap: 0; margin: 1.5rem 0; position: relative; }
  .flow-steps::before { content: ''; position: absolute; left: 1.5rem; top: 2rem; bottom: 2rem; width: 2px; background: var(--surface-border); }
  .flow-step { padding: 1.5rem 1.5rem 1.5rem 4rem; position: relative; background: var(--surface); margin-bottom: 0.75rem; border-radius: 8px; border: 1px solid var(--surface-border); }
  .step-num { position: absolute; left: 1rem; top: 1.5rem; width: 2rem; height: 2rem; background: var(--primary); color: #000; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.8rem; }
  .step-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; margin-bottom: 0.5rem; display: inline-block; padding: 0.15rem 0.5rem; border-radius: 4px; }
  .step-label.front-channel { background: rgba(251,191,36,0.2); color: #fbbf24; }
  .step-label.back-channel { background: rgba(52,211,153,0.2); color: var(--success); }
  .step-label.resource { background: rgba(56,189,248,0.2); color: var(--primary); }
  .flow-step h4 { margin: 0.5rem 0; }
  .flow-step p { margin-bottom: 0.75rem; color: var(--text-muted); font-size: 0.95rem; }

  /* Param table */
  .param-table { margin-top: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .param { display: flex; gap: 1rem; align-items: baseline; padding: 0.5rem; background: var(--bg); border-radius: 4px; font-size: 0.85rem; }
  .param code { flex-shrink: 0; }
  .param span { color: var(--text-muted); }

  /* PKCE */
  .pkce-steps { display: flex; flex-direction: column; gap: 1rem; margin: 1.5rem 0; counter-reset: pkce; }
  .pkce-step { display: flex; gap: 1.25rem; padding: 1.25rem; background: var(--surface); border-radius: 8px; border: 1px solid var(--surface-border); }
  .pkce-num { font-size: 1.5rem; flex-shrink: 0; }
  .pkce-step h4 { margin: 0 0 0.5rem; }
  .pkce-step p { margin: 0.5rem 0; color: var(--text-muted); font-size: 0.9rem; }

  /* Tabs */
  .flow-tabs { margin: 1.5rem 0; border: 1px solid var(--surface-border); border-radius: 8px; overflow: hidden; }
  .tabs-header { display: flex; border-bottom: 1px solid var(--surface-border); }
  .tab-btn { flex: 1; padding: 0.75rem 1rem; background: var(--surface); color: var(--text-muted); border: none; cursor: pointer; font-size: 0.9rem; transition: all 0.2s; }
  .tab-btn.active { background: var(--bg); color: var(--primary); font-weight: 600; }
  .tab-content { display: none; padding: 1.5rem; }
  .tab-content.active { display: block; }
  .app-type-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; }

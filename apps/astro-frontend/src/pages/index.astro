---
import Layout from '../layouts/Layout.astro';
const user = Astro.locals.user;
---

<Layout title="Home">
  <section class="hero">
    <h1>⚡ AuthMatrix Enterprise Identity Masterclass</h1>
    <p class="subtitle">
      A hands-on, practical sandbox for learning OIDC, SAML 2.0, OAuth 2.0, JWT validation, and RBAC with Astro & Enterprise Identity Providers.
    </p>
    
    <div class="hero-actions">
      {user ? (
        <a href="/dashboard" class="btn-hero btn-hero-primary">Enter Dashboard &rarr;</a>
      ) : (
        <a href="/login" class="btn-hero btn-hero-primary">Launch Auth Simulator &rarr;</a>
      )}
      <a href="/docs/00-tenant-setup-guide.md" class="btn-hero btn-hero-secondary">View Tenant Setup Guide</a>
    </div>
  </section>

  <section class="grid-features">
    <div class="card">
      <div class="card-icon">🔐</div>
      <h3>Authentication & OIDC</h3>
      <p>Master OpenID Connect (OIDC) Authorization Code Flow with PKCE using Okta Preview and Microsoft Entra ID.</p>
    </div>

    <div class="card">
      <div class="card-icon">📜</div>
      <h3>SAML 2.0 Enterprise SSO</h3>
      <p>Configure SP & IdP-initiated SAML single sign-on, certificates, ACS endpoints, and assertion claim extraction.</p>
    </div>

    <div class="card">
      <div class="card-icon">🛡️</div>
      <h3>Astro RBAC Middleware</h3>
      <p>Protect routes using Astro's server middleware (<code>src/middleware.ts</code>) and enforce permission controls.</p>
    </div>

    <div class="card">
      <div class="card-icon">⚡</div>
      <h3>Resource Server Security</h3>
      <p>Validate JWT signatures via JWKS endpoints, verify issuer/audience, and enforce API scopes & claims.</p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 3rem 1rem 4rem 1rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .hero h1 {
    font-size: 2.8rem;
    font-weight: 800;
    line-height: 1.2;
    background: linear-gradient(135deg, #ffffff 0%, #93c5fd 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1.2rem;
  }

  .subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-hero {
    padding: 0.8rem 1.6rem;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .btn-hero:hover {
    transform: translateY(-2px);
  }

  .btn-hero-primary {
    background: var(--primary);
    color: #0f172a;
    box-shadow: 0 4px 14px rgba(56, 189, 248, 0.35);
  }

  .btn-hero-secondary {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--surface-border);
  }

  .grid-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--surface-border);
    padding: 1.75rem;
    border-radius: 12px;
  }

  .card-icon {
    font-size: 2.2rem;
    margin-bottom: 0.75rem;
  }

  .card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .card p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>

---
import Layout from '../../layouts/Layout.astro';
const user     = Astro.locals.user;
const rawToken = Astro.cookies.get('auth_token')?.value || '';
---
<Layout title="Reports">
  <div class="page-header">
    <h2>📊 Reports</h2>
    <p>Access granted for roles: <strong>Manager · Developer · Admin</strong></p>
    <p class="sub">Your role: <span class="role-tag">{(user?.roles as string[])?.[0]}</span></p>
  </div>

  <div class="content-grid">
    <div class="dash-card">
      <h3>Available Reports</h3>
      <div class="report-list" id="report-list">
        <p class="loading">⏳ Loading reports from API...</p>
      </div>
    </div>

    <div class="dash-card">
      <h3>Write Report <span class="scope-tag">write:reports</span></h3>
      <p class="card-sub">Manager and Admin roles can create new reports.</p>
      <form id="report-form" class="report-form">
        <input id="report-title" type="text" placeholder="Report title" class="form-input" />
        <textarea id="report-content" placeholder="Report content..." class="form-textarea" rows="4"></textarea>
        <button type="submit" class="btn-submit">Create Report</button>
      </form>
      <div class="output-box" id="write-output-box" style="display:none">
        <pre id="write-output"></pre>
      </div>
    </div>
  </div>

  <div class="zero-trust-note">
    🛡️ <strong>Zero Trust:</strong> This page is protected by Astro middleware (<code>src/middleware.ts</code>).
    The API calls below are additionally protected by the Express Resource Server with <code>requirePermission('read:reports')</code>.
    Two enforcement layers — both must pass.
  </div>
</Layout>

<script is:inline define:vars={{ rawToken }}>
  // Load reports on page mount
  async function loadReports() {
    const list = document.getElementById('report-list');
    try {
      const res  = await fetch('http://localhost:4000/api/protected/reports', {
        headers: { 'Authorization': `Bearer ${rawToken}` }
      });
      const data = await res.json();
      if (!res.ok) {
        list.innerHTML = `<div class="error-msg">❌ ${data.message || 'Access denied'} (${res.status})</div>`;
        return;
      }
      list.innerHTML = data.reports.map(r => `
        <div class="report-item">
          <span class="report-id">#${r.id}</span>
          <div class="report-info">
            <span class="report-title">${r.title}</span>
            <span class="report-class ${r.classification.toLowerCase()}">${r.classification}</span>
          </div>
        </div>
      `).join('');
    } catch (err) {
      list.innerHTML = `<div class="error-msg">⚠️ API server not running on port 4000.<br>Run: <code>npm run dev --workspace=apps/api-server</code></div>`;
    }
  }

  loadReports();

  document.getElementById('report-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const box = document.getElementById('write-output-box');
    const pre = document.getElementById('write-output');
    box.style.display = 'block';
    pre.textContent = '⏳ Submitting...';

    try {
      const res  = await fetch('http://localhost:4000/api/protected/reports', {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${rawToken}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title:   document.getElementById('report-title').value,
          content: document.getElementById('report-content').value,
        })
      });
      const data = await res.json();
      pre.textContent = `STATUS ${res.status}\n\n${JSON.stringify(data, null, 2)}`;
      pre.style.color = res.ok ? '#34d399' : '#f87171';
    } catch (err) {
      pre.textContent = `Error: ${err.message}`;
      pre.style.color = '#f87171';
    }
  });
</script>

<style>
  .page-header { margin-bottom: 2rem; }
  .page-header h2 { font-size: 1.8rem; font-weight: 800; margin-bottom: 0.4rem; }
  .page-header p { color: var(--text-muted); font-size: 0.9rem; }
  .sub { margin-top: 0.4rem !important; }
  .role-tag { background: rgba(251,191,36,0.15); color: #fbbf24; border: 1px solid rgba(251,191,36,0.3); font-size: 0.75rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: 5px; }
  .scope-tag { background: rgba(56,189,248,0.12); color: var(--primary); border: 1px solid rgba(56,189,248,0.25); font-size: 0.65rem; font-family: var(--font-code); padding: 0.1rem 0.4rem; border-radius: 4px; margin-left: 0.5rem; font-weight: 400; }

  .content-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem; }
  .dash-card { background: var(--surface); border: 1px solid var(--surface-border); padding: 1.75rem; border-radius: 14px; }
  .dash-card h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 1rem; }
  .card-sub { color: var(--text-muted); font-size: 0.82rem; margin-bottom: 1rem; }

  .loading { color: var(--text-muted); font-style: italic; font-size: 0.88rem; }
  .report-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem; border-radius: 6px; border: 1px solid var(--surface-border); margin-bottom: 0.5rem; }
  .report-id { color: var(--text-muted); font-family: var(--font-code); font-size: 0.75rem; min-width: 30px; }
  .report-info { display: flex; flex-direction: column; gap: 0.1rem; }
  .report-title { font-size: 0.88rem; font-weight: 600; }
  .report-class { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; padding: 0.1rem 0.35rem; border-radius: 3px; width: fit-content; }
  .confidential { background: rgba(248,113,113,0.15); color: #f87171; }
  .internal     { background: rgba(251,191,36,0.15); color: #fbbf24; }
  .error-msg { color: var(--danger); font-size: 0.85rem; line-height: 1.6; }
  .error-msg code { font-family: var(--font-code); background: rgba(0,0,0,0.3); padding: 0.1rem 0.3rem; border-radius: 3px; }

  .report-form { display: flex; flex-direction: column; gap: 0.75rem; }
  .form-input, .form-textarea { background: #0f1929; border: 1px solid var(--surface-border); border-radius: 8px; padding: 0.65rem 0.85rem; color: var(--text); font-family: var(--font-main); font-size: 0.88rem; outline: none; transition: border-color 0.2s; resize: vertical; }
  .form-input:focus, .form-textarea:focus { border-color: var(--primary); }
  .btn-submit { background: var(--primary); color: #0f172a; font-weight: 700; padding: 0.65rem; border-radius: 8px; border: none; cursor: pointer; font-size: 0.9rem; transition: background 0.2s; }
  .btn-submit:hover { background: var(--primary-hover); }

  .output-box { background: #070c14; border: 1px solid var(--surface-border); border-radius: 8px; margin-top: 0.75rem; }
  .output-box pre { padding: 0.75rem; font-family: var(--font-code); font-size: 0.75rem; white-space: pre-wrap; margin: 0; max-height: 150px; overflow-y: auto; }

  .zero-trust-note { background: rgba(56,189,248,0.06); border: 1px solid rgba(56,189,248,0.2); border-radius: 10px; padding: 1rem 1.25rem; font-size: 0.85rem; color: var(--text-muted); line-height: 1.6; }
  .zero-trust-note strong { color: var(--primary); }
  .zero-trust-note code { font-family: var(--font-code); color: var(--primary); font-size: 0.8rem; }

  @media (max-width: 768px) { .content-grid { grid-template-columns: 1fr; } }
</style>

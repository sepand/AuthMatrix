# ==========================================
# LEARN IDM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# Local Application Settings
PORT=3000
API_PORT=4000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# ------------------------------------------
# OKTA DEVELOPER PREVIEW SETTINGS
# ------------------------------------------
# Your Okta Org URL (e.g., https://dev-12345678.okta.com)
OKTA_ORG_URL=https://dev-YOUR-TENANT.okta.com
OKTA_ISSUER=https://dev-YOUR-TENANT.okta.com/oauth2/default

# OIDC Web Application Credentials
OKTA_CLIENT_ID=your_okta_client_id
OKTA_CLIENT_SECRET=your_okta_client_secret
OKTA_REDIRECT_URI=http://localhost:3000/authorization-code/callback

# SAML 2.0 Settings (Okta SP Integration)
OKTA_SAML_ENTRY_POINT=https://dev-YOUR-TENANT.okta.com/app/YOUR_APP_ID/sso/saml
OKTA_SAML_ISSUER=http://www.okta.com/YOUR_ENTITY_ID
OKTA_SAML_CERT=-----BEGIN CERTIFICATE-----\nYOUR_OKTA_X509_CERTIFICATE_HERE\n-----END CERTIFICATE-----

# ------------------------------------------
# MICROSOFT ENTRA ID (AZURE AD) SETTINGS
# ------------------------------------------
# Tenant ID or 'common' / 'organizations'
ENTRA_TENANT_ID=your_azure_tenant_id_or_directory_id
ENTRA_CLIENT_ID=your_azure_app_registration_client_id
ENTRA_CLIENT_SECRET=your_azure_app_registration_client_secret
ENTRA_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
ENTRA_REDIRECT_URI=http://localhost:3000/auth/entra/callback

# Entra SAML Settings
ENTRA_SAML_ENTRY_POINT=https://login.microsoftonline.com/YOUR_TENANT_ID/saml2
ENTRA_SAML_ISSUER=api://your-app-entity-id

# ------------------------------------------
# MACHINE-TO-MACHINE (M2M) CLIENT CREDENTIALS
# ------------------------------------------
M2M_CLIENT_ID=your_m2m_service_client_id
M2M_CLIENT_SECRET=your_m2m_service_client_secret
M2M_AUDIENCE=https://api.learnidm.local

# ------------------------------------------
# SCIM 2.0 PROVISIONING SETTINGS
# ------------------------------------------
SCIM_BEARER_TOKEN=super_secret_scim_provisioning_token_12345

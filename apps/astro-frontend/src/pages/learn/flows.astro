  .app-card h4 { margin: 0 0 0.5rem; font-size: 0.95rem; }
  .app-card p { font-size: 0.8rem; color: var(--text-muted); margin: 0 0 0.75rem; }
  .app-flow { font-size: 0.75rem; font-weight: 700; color: var(--primary); background: rgba(56,189,248,0.1); padding: 0.25rem 0.5rem; border-radius: 4px; }

  /* Device display */
  .device-display { background: #1a1a2e; border: 2px solid var(--surface-border); border-radius: 8px; padding: 1.5rem; text-align: center; margin: 1rem 0; }
  .user-code { font-size: 2rem; font-weight: 700; letter-spacing: 0.2em; color: var(--primary); font-family: monospace; margin-top: 0.5rem; }

  /* Security checklist */
  .security-checklist { display: flex; flex-direction: column; gap: 0.75rem; }
  .check-item { display: flex; gap: 0.75rem; align-items: flex-start; padding: 0.75rem; background: var(--surface); border-radius: 6px; cursor: pointer; font-size: 0.95rem; }
  .check-item input { margin-top: 0.15rem; accent-color: var(--success); flex-shrink: 0; }
  .check-item:has(input:checked) { background: rgba(52,211,153,0.08); }

  .page-references { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--surface-border); }
  .page-references h3 { margin-bottom: 1rem; }
  .page-references ul { list-style: none; padding: 0; }
  .page-references li { margin-bottom: 0.5rem; }
  .page-references a { color: var(--primary); text-decoration: none; }
  .page-references a:hover { text-decoration: underline; }
  .page-nav { display: flex; justify-content: space-between; margin-top: 2rem; }
  .page-nav a { color: var(--primary); text-decoration: none; font-weight: 600; }
</style>

<script>
  // Tab switching
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.dataset.tab;
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab-' + tab)?.classList.add('active');
    });
  });
</script>

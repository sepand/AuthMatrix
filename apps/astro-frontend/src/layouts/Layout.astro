---
interface Props {
  title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="AuthMatrix - Enterprise Identity & Access Management Sandbox" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | AuthMatrix ⚡</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  </head>
  <body>
    <header class="navbar">
      <div class="nav-container">
        <a href="/" class="brand">
          <span class="brand-icon">⚡</span>
          <span class="brand-name">AuthMatrix</span>
          <span class="badge">Enterprise IDM</span>
        </a>
        <nav class="nav-links">
          <a href="/">Overview</a>
          <a href="/dashboard">Dashboard</a>
          <a href="/dashboard/reports">Reports</a>
          <a href="/dashboard/audit">Audit</a>
          <a href="/dashboard/admin">Admin Zone</a>
          {user ? (
            <div class="user-pill">
              <span class="user-name">{user.name}</span>
              <span class="role-tag">{user.roles?.[0] || 'User'}</span>
              <a href="/api/auth/logout" class="btn-logout">Logout</a>
            </div>
          ) : (
            <a href="/login" class="btn-primary">Sign In / Simulate Auth</a>
          )}
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="footer">
      <p>⚡ AuthMatrix Enterprise Identity Masterclass &bull; Open-Source Sandbox</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #090d16;
    --surface: #111827;
    --surface-border: #1f293d;
    --text: #f3f4f6;
    --text-muted: #9ca3af;
    --primary: #38bdf8;
    --primary-hover: #0284c7;
    --accent: #818cf8;
    --danger: #f87171;
    --success: #34d399;
    --font-main: 'Plus Jakarta Sans', sans-serif;
    --font-code: 'JetBrains Mono', monospace;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-main);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .navbar {
    background-color: rgba(17, 24, 39, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--surface-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text);
    font-weight: 800;
    font-size: 1.25rem;
  }

  .brand-icon {
    font-size: 1.4rem;
  }

  .badge {
    background: rgba(56, 189, 248, 0.15);
    color: var(--primary);
    border: 1px solid rgba(56, 189, 248, 0.3);
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    font-weight: 600;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--primary);
  }

  .user-pill {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--surface);
    border: 1px solid var(--surface-border);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
  }

  .user-name {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .role-tag {
    background: #374151;
    color: #fbbf24;
    font-size: 0.7rem;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .btn-primary {
    background: var(--primary);
    color: #0f172a !important;
    padding: 0.5rem 1.1rem;
    border-radius: 8px;
    font-weight: 700 !important;
  }

  .btn-primary:hover {
    background: var(--primary-hover);
  }

  .btn-logout {
    color: var(--danger) !important;
    font-size: 0.8rem !important;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
    flex: 1;
    width: 100%;
  }

  .footer {
    border-top: 1px solid var(--surface-border);
    text-align: center;
    padding: 1.5rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
</style>
